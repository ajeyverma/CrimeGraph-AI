{
  "name": "@crimegraph/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "electron:dev": "npx concurrently -k \"vite\" \"npx wait-on http://127.0.0.1:5173 && npx electron .\"",
    "electron:build": "npm run build && npx electron-builder --win"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "axios": "^1.20.0",
    "cytoscape": "^3.34.3",
    "cytoscape-cose-bilkent": "^4.1.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.344.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.19.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.3.2",
    "vite": "^5.1.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.crimegraph.ai",
    "productName": "CrimeGraph AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.png"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
